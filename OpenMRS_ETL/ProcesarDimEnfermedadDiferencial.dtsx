    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{FFD8C9D7-06CD-44F0-9261-2D8F5F6F7E38}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;    c.concept_id AS EnfermedadId,&#xA;&#x9;COALESCE(n.nombre_es, n.nombre_en) AS Nombre,&#xA;    COALESCE(&#xA;        CASE LEFT(icd.icd10, 1)&#xA;            WHEN 'A' THEN 'Infecciosas y parasitarias'&#xA;            WHEN 'B' THEN 'Infecciosas y parasitarias'&#xA;            WHEN 'C' THEN 'Tumores'&#xA;            WHEN 'D' THEN 'Tumores / Enfermedades de la sangre'&#xA;            WHEN 'E' THEN 'Endocrinas, nutricionales y metabólicas'&#xA;            WHEN 'F' THEN 'Mentales y del comportamiento'&#xA;            WHEN 'G' THEN 'Del sistema nervioso'&#xA;            WHEN 'H' THEN 'Ojo y oído'&#xA;            WHEN 'I' THEN 'Circulatorias'&#xA;            WHEN 'J' THEN 'Respiratorias'&#xA;            WHEN 'K' THEN 'Digestivas'&#xA;            WHEN 'L' THEN 'Piel'&#xA;            WHEN 'M' THEN 'Musculoesqueléticas'&#xA;            WHEN 'N' THEN 'Genitourinarias'&#xA;            WHEN 'O' THEN 'Embarazo y parto'&#xA;            WHEN 'P' THEN 'Perinatales'&#xA;            WHEN 'Q' THEN 'Malformaciones congénitas'&#xA;            WHEN 'R' THEN 'Síntomas y hallazgos anormales'&#xA;            WHEN 'S' THEN 'Traumatismos'&#xA;            WHEN 'T' THEN 'Traumatismos / Intoxicaciones'&#xA;            WHEN 'Z' THEN 'Factores de salud'&#xA;            ELSE NULL&#xA;        END,&#xA;        'Sin categoría'&#xA;    ) AS tipoEnfermedad&#xA;FROM concept c&#xA;LEFT JOIN (&#xA;    SELECT m.concept_id, MIN(t.code) AS icd10&#xA;    FROM concept_reference_map m&#xA;    JOIN concept_reference_term t&#xA;        ON t.concept_reference_term_id = m.concept_reference_term_id&#xA;       AND t.retired = 0&#xA;    JOIN concept_reference_source s&#xA;        ON s.concept_source_id = t.concept_source_id&#xA;       AND s.name = 'ICD-10-WHO'&#xA;    GROUP BY m.concept_id&#xA;) icd ON icd.concept_id = c.concept_id&#xA;LEFT JOIN (&#xA;    SELECT concept_id,&#xA;           MAX(CASE WHEN locale = 'es' THEN name END) AS nombre_es,&#xA;           MAX(CASE WHEN locale = 'en' THEN name END) AS nombre_en&#xA;    FROM concept_name&#xA;    WHERE voided = 0&#xA;    AND concept_name_type = 'FULLY_SPECIFIED'&#xA;    GROUP BY concept_id&#xA;) n ON n.concept_id = c.concept_id&#xA;WHERE c.retired = 0&#xA;  AND c.concept_id IN (&#xA;      SELECT DISTINCT diagnosis_coded FROM encounter_diagnosis WHERE voided = 0&#xA;  )&#xA;  AND (c.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE() OR c.concept_id IN (&#xA;    SELECT m.concept_id&#xA;    FROM concept_reference_map m&#xA;    JOIN concept_reference_term t ON t.concept_reference_term_id = m.concept_reference_term_id&#xA;    WHERE t.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE()&#xA;  ))&#xA;  ;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConsultaEnfermedadDiferencial">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
    c.concept_id AS EnfermedadId,
	COALESCE(n.nombre_es, n.nombre_en) AS Nombre,
    COALESCE(
        CASE LEFT(icd.icd10, 1)
            WHEN 'A' THEN 'Infecciosas y parasitarias'
            WHEN 'B' THEN 'Infecciosas y parasitarias'
            WHEN 'C' THEN 'Tumores'
            WHEN 'D' THEN 'Tumores / Enfermedades de la sangre'
            WHEN 'E' THEN 'Endocrinas, nutricionales y metabólicas'
            WHEN 'F' THEN 'Mentales y del comportamiento'
            WHEN 'G' THEN 'Del sistema nervioso'
            WHEN 'H' THEN 'Ojo y oído'
            WHEN 'I' THEN 'Circulatorias'
            WHEN 'J' THEN 'Respiratorias'
            WHEN 'K' THEN 'Digestivas'
            WHEN 'L' THEN 'Piel'
            WHEN 'M' THEN 'Musculoesqueléticas'
            WHEN 'N' THEN 'Genitourinarias'
            WHEN 'O' THEN 'Embarazo y parto'
            WHEN 'P' THEN 'Perinatales'
            WHEN 'Q' THEN 'Malformaciones congénitas'
            WHEN 'R' THEN 'Síntomas y hallazgos anormales'
            WHEN 'S' THEN 'Traumatismos'
            WHEN 'T' THEN 'Traumatismos / Intoxicaciones'
            WHEN 'Z' THEN 'Factores de salud'
            ELSE NULL
        END,
        'Sin categoría'
    ) AS tipoEnfermedad
FROM concept c
LEFT JOIN (
    SELECT m.concept_id, MIN(t.code) AS icd10
    FROM concept_reference_map m
    JOIN concept_reference_term t
        ON t.concept_reference_term_id = m.concept_reference_term_id
       AND t.retired = 0
    JOIN concept_reference_source s
        ON s.concept_source_id = t.concept_source_id
       AND s.name = 'ICD-10-WHO'
    GROUP BY m.concept_id
) icd ON icd.concept_id = c.concept_id
LEFT JOIN (
    SELECT concept_id,
           MAX(CASE WHEN locale = 'es' THEN name END) AS nombre_es,
           MAX(CASE WHEN locale = 'en' THEN name END) AS nombre_en
    FROM concept_name
    WHERE voided = 0
    AND concept_name_type = 'FULLY_SPECIFIED'
    GROUP BY concept_id
) n ON n.concept_id = c.concept_id
WHERE c.retired = 0
  AND c.concept_id IN (
      SELECT DISTINCT diagnosis_coded FROM encounter_diagnosis WHERE voided = 0
  )
  AND (c.date_changed BETWEEN '2026-10-01' AND CURDATE() OR c.concept_id IN (
    SELECT m.concept_id
    FROM concept_reference_map m
    JOIN concept_reference_term t ON t.concept_reference_term_id = m.concept_reference_term_id
    WHERE t.date_changed BETWEEN '2026-10-01' AND CURDATE()
  ))
  ;</DTS:VariableValue>
    </DTS:Variable>
