  DTS:VersionGUID="{F87DC22C-A0B3-4172-8DA2-7683180E8F1E}">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{9ADCA409-86A2-4CFB-8924-F514475D3E32}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;    c.concept_id AS SignoVitalId,&#xA;    COALESCE(&#xA;        (SELECT cn.name FROM concept_name cn&#xA;          WHERE cn.concept_id = c.concept_id AND cn.locale = 'es' AND cn.voided = 0&#xA;            AND cn.concept_name_type = 'FULLY_SPECIFIED' LIMIT 1),&#xA;        (SELECT cn2.name FROM concept_name cn2&#xA;          WHERE cn2.concept_id = c.concept_id AND cn2.locale = 'en' AND cn2.voided = 0&#xA;            AND cn2.concept_name_type = 'FULLY_SPECIFIED' LIMIT 1),&#xA;        'N/NOMBRE'&#xA;    ) AS Nombre,&#xA;    IFNULL(cnu.units, 'N/UNIDAD') AS Unidad,&#xA;    COALESCE(c.retired, 0) AS EstaRetirado&#xA;FROM concept c&#xA;JOIN concept_numeric cnu ON cnu.concept_id = c.concept_id&#xA;WHERE c.concept_id IN (&#xA;    SELECT DISTINCT o.concept_id FROM obs o&#xA;    WHERE o.voided = 0 AND o.concept_id IN (4165, 4167, 4168, 4169, 4171, 4173)&#xA;)&#xA;AND (c.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE() OR c.date_created BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE() ) &#xA;;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConsultaSigVitalesDiferencial">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
    c.concept_id AS SignoVitalId,
    COALESCE(
        (SELECT cn.name FROM concept_name cn
          WHERE cn.concept_id = c.concept_id AND cn.locale = 'es' AND cn.voided = 0
            AND cn.concept_name_type = 'FULLY_SPECIFIED' LIMIT 1),
        (SELECT cn2.name FROM concept_name cn2
          WHERE cn2.concept_id = c.concept_id AND cn2.locale = 'en' AND cn2.voided = 0
            AND cn2.concept_name_type = 'FULLY_SPECIFIED' LIMIT 1),
        'N/NOMBRE'
    ) AS Nombre,
    IFNULL(cnu.units, 'N/UNIDAD') AS Unidad,
    COALESCE(c.retired, 0) AS EstaRetirado
FROM concept c
JOIN concept_numeric cnu ON cnu.concept_id = c.concept_id
WHERE c.concept_id IN (
    SELECT DISTINCT o.concept_id FROM obs o
    WHERE o.voided = 0 AND o.concept_id IN (4165, 4167, 4168, 4169, 4171, 4173)
)
AND (c.date_changed BETWEEN '2026-10-02' AND CURDATE() OR c.date_created BETWEEN '2026-10-02' AND CURDATE() ) 
;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{A4EED0A7-FBED-4955-8F60-DBA29963FE33}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaUltimaEjecucion">
      <DTS:VariableValue
        DTS:DataType="8">2026-10-02</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
