  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{78BA3509-8FE9-4C08-B99A-98B4EA783326}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;SELECT&#xA;et.encounter_type_id encounterTypeId,&#xA;UPPER(et.name) nombre,&#xA;IFNULL(UPPER(et.description), 'N/A') descripcion,&#xA;et.retired estaRetirado,&#xA;et.date_created fechaCreacion,&#xA;et.date_retired fechaRetiro,&#xA;NOW() fechaProceso&#xA;FROM encounter_type et&#xA;WHERE et.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE()&#xA;OR et.date_created  BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE()&#xA;;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConsultaTipoEncuentroIncremental">
      <DTS:VariableValue
        DTS:DataType="8">
SELECT
et.encounter_type_id encounterTypeId,
UPPER(et.name) nombre,
IFNULL(UPPER(et.description), 'N/A') descripcion,
et.retired estaRetirado,
et.date_created fechaCreacion,
et.date_retired fechaRetiro,
NOW() fechaProceso
FROM encounter_type et
WHERE et.date_changed BETWEEN '2026-10-01' AND CURDATE()
OR et.date_created  BETWEEN '2026-10-01' AND CURDATE()
;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{0D426AB1-6854-4E3E-9767-BA731AA9F2DB}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaUltimaEjecucion">
      <DTS:VariableValue
        DTS:DataType="8">2026-10-01</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
