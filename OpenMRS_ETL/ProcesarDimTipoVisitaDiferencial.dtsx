  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6284B49C-3BB5-4C67-A73A-01CC355FAFFD}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;p.provider_id providerId,&#xA;p.person_id personId,&#xA;UPPER(&#xA;&#x9;COALESCE(&#xA;&#x9;&#x9;NULLIF(TRIM(p.name), ''),&#xA;&#x9;&#x9;NULLIF(TRIM(CONCAT_WS(' ', pn.given_name, pn.middle_name, pn.family_name, pn.family_name2)), ''),&#xA;&#x9;&#x9;'N/A'&#xA;&#x9;)&#xA;) nombreCompleto,&#xA;IFNULL(p.identifier, 'N/A') identificador,&#xA;p.retired estaRetirado,&#xA;p.date_created fechaCreacion,&#xA;p.date_retired fechaRetiro,&#xA;NOW() fechaProceso&#xA;FROM openmrs.provider p&#xA;LEFT JOIN openmrs.person_name pn ON p.person_id = pn.person_id&#xA;&#x9;AND pn.voided = 0&#xA;&#x9;AND pn.preferred = 1&#xA;WHERE (p.date_changed IS NOT NULL &#xA;&#x9;  AND p.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE()) &#xA;      OR (p.date_created IS NOT NULL &#xA;      AND p.date_created BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE())&#xA;ORDER BY p.provider_id ASC;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConsultaMariaDB">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
p.provider_id providerId,
p.person_id personId,
UPPER(
	COALESCE(
		NULLIF(TRIM(p.name), ''),
		NULLIF(TRIM(CONCAT_WS(' ', pn.given_name, pn.middle_name, pn.family_name, pn.family_name2)), ''),
		'N/A'
	)
) nombreCompleto,
IFNULL(p.identifier, 'N/A') identificador,
p.retired estaRetirado,
p.date_created fechaCreacion,
p.date_retired fechaRetiro,
NOW() fechaProceso
FROM openmrs.provider p
LEFT JOIN openmrs.person_name pn ON p.person_id = pn.person_id
	AND pn.voided = 0
	AND pn.preferred = 1
WHERE (p.date_changed IS NOT NULL 
	  AND p.date_changed BETWEEN '2026-10-01' AND CURDATE()) 
      OR (p.date_created IS NOT NULL 
      AND p.date_created BETWEEN '2026-10-01' AND CURDATE())
ORDER BY p.provider_id ASC;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{FA88AFAD-3BC3-4E9A-BADB-CBAFAB5C9C62}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT &#x9;VT.visit_type_id AS TipoVisitaId,&#xA;&#x9;&#x9;VT.name AS Nombre,&#xA;&#x9;&#x9;VT.description AS Descripcion&#xA;FROM openmrs.visit_type VT&#xA;WHERE (VT.date_changed IS NOT NULL &#xA;&#x9;  AND VT.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND NOW()) &#xA;      OR (VT.date_created IS NOT NULL &#xA;      AND VT.date_created BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND NOW());&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConsultaTipoVisitaIncremental">
      <DTS:VariableValue
        DTS:DataType="8">SELECT 	VT.visit_type_id AS TipoVisitaId,
		VT.name AS Nombre,
		VT.description AS Descripcion
FROM openmrs.visit_type VT
WHERE (VT.date_changed IS NOT NULL 
	  AND VT.date_changed BETWEEN '2026-10-01' AND NOW()) 
      OR (VT.date_created IS NOT NULL 
      AND VT.date_created BETWEEN '2026-10-01' AND NOW());</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{78FFF723-7214-4AD5-BA80-C8F3AA8EBCE7}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaUltimaEjecucion">
      <DTS:VariableValue
        DTS:DataType="8">2026-10-01</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
