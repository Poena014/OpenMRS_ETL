  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F65FFC5E-C978-4D1E-A2D1-82AE9E7C60F3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select DISTINCT &#xA;UPPER(CONCAT_WS(', ', pa.address1, pa.county_district, pa.city_village, pa.state_province, pa.country)) direccionId,&#xA;UPPER(IFNULL(pa.city_village,'N/CIUDAD')) ciudad,&#xA;UPPER(IFNULL(pa.state_province,'N/DEPARTAMENTO')) departamento ,&#xA;UPPER(IFNULL(pa.country,'N/PAIS')) pais,&#xA;UPPER(IFNULL(pa.postal_code,'N/POSTAL')) codigoPostal&#xA;from obs o &#xA;join person p on o.person_id =p.person_id &#xA;join person_address pa on p.person_id =pa.person_id &#xA;WHERE (p.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE() OR pa.date_changed BETWEEN '&quot; + @[User::FechaUltimaEjecucion] + &quot;' AND CURDATE() )&#xA;;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="ConsultaUbicacionDiferencial">
      <DTS:VariableValue
        DTS:DataType="8">select DISTINCT 
UPPER(CONCAT_WS(', ', pa.address1, pa.county_district, pa.city_village, pa.state_province, pa.country)) direccionId,
UPPER(IFNULL(pa.city_village,'N/CIUDAD')) ciudad,
UPPER(IFNULL(pa.state_province,'N/DEPARTAMENTO')) departamento ,
UPPER(IFNULL(pa.country,'N/PAIS')) pais,
UPPER(IFNULL(pa.postal_code,'N/POSTAL')) codigoPostal
from obs o 
join person p on o.person_id =p.person_id 
join person_address pa on p.person_id =pa.person_id 
WHERE (p.date_changed BETWEEN '2026-10-01' AND CURDATE() OR pa.date_changed BETWEEN '2026-10-01' AND CURDATE() )
;</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{F62BF22D-A2F9-41D3-9D9A-282A8A40AA65}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="FechaUltimaEjecucion">
      <DTS:VariableValue
        DTS:DataType="8">2026-10-01</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
