table FactDiagnosticos
	lineageTag: e41578fd-deac-4610-8b98-195cb0bf970c

	measure Diagnósticos = COUNTROWS(FactDiagnosticos)
		formatString: 0
		lineageTag: 87e1e5e1-0fc9-4b32-92d7-97dcd70ec9b9

	measure 'Pacientes con diagnósticos' = DISTINCTCOUNT(FactDiagnosticos[PacienteKey])
		formatString: 0
		lineageTag: 8f8c1632-1126-4c95-b3bb-0649546234f8

	measure 'Diagnósticos repetidos' = CALCULATE([Diagnósticos], FactDiagnosticos[EsRepetido] = 1)
		formatString: 0
		lineageTag: 047137d7-d15f-4af4-b454-8d6aeb9849c6

	measure '% diagnósticos repetidos' = DIVIDE([Diagnósticos repetidos], [Diagnósticos])
		formatString: 0.0%
		lineageTag: 2d762823-2645-4af6-a2ee-2a72903d5ced

	measure 'Edad promedio al diagnóstico' = AVERAGE(FactDiagnosticos[EdadSuceso])
		formatString: 0.0
		lineageTag: 8bfaa861-6c63-4f31-85cd-2ed69bb7d170

	measure 'Diagnósticos meses completos' = VAR UltimaFecha = MAXX(ALL(FactDiagnosticos), RELATED(DimTiempo[Fecha])) VAR FinMesContexto = EOMONTH(MAX(DimTiempo[Fecha]), 0) RETURN IF(FinMesContexto = EOMONTH(UltimaFecha, 0) && UltimaFecha < EOMONTH(UltimaFecha, 0), BLANK(), [Diagnósticos])
		formatString: 0
		lineageTag: 1d03b5ae-03cd-4400-9837-d90c6697b3f5

	measure 'Diagnósticos repetidos meses completos' =
			
			VAR UltimaFecha = MAXX(ALL(FactDiagnosticos), RELATED(DimTiempo[Fecha]))
			VAR FinMesContexto = EOMONTH(MAX(DimTiempo[Fecha]), 0)
			RETURN IF(
			    FinMesContexto = EOMONTH(UltimaFecha, 0) && UltimaFecha < EOMONTH(UltimaFecha, 0),
			    BLANK(),
			    [Diagnósticos repetidos]
			)
		formatString: 0
		lineageTag: 6919d605-9d6f-47eb-9277-c3f58aa55eb0

