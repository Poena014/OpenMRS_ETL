	column RangoEdad =
			
			SWITCH(
			    TRUE(),
			    FactDiagnosticos[EdadSuceso] < 3,  "0-2",
			    FactDiagnosticos[EdadSuceso] < 11, "3-10",
			    FactDiagnosticos[EdadSuceso] < 18, "11-17",
			    FactDiagnosticos[EdadSuceso] < 30, "18-29",
			    FactDiagnosticos[EdadSuceso] < 45, "30-44",
			    FactDiagnosticos[EdadSuceso] < 60, "45-59",
			    FactDiagnosticos[EdadSuceso] < 70, "60-69",
			    FactDiagnosticos[EdadSuceso] < 80, "70-79",
			    FactDiagnosticos[EdadSuceso] >= 80, "80+",
			    "Sin edad"
			)
		lineageTag: d1acb264-7270-485a-8d33-8b9de87d2894
		summarizeBy: none
		sortByColumn: OrdenRango

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column OrdenRango =
			
			SWITCH(
			    TRUE(),
			    FactDiagnosticos[EdadSuceso] < 3,  1,
			    FactDiagnosticos[EdadSuceso] < 11, 2,
			    FactDiagnosticos[EdadSuceso] < 18, 3,
			    FactDiagnosticos[EdadSuceso] < 30, 4,
			    FactDiagnosticos[EdadSuceso] < 45, 5,
			    FactDiagnosticos[EdadSuceso] < 60, 6,
			    FactDiagnosticos[EdadSuceso] < 70, 7,
			    FactDiagnosticos[EdadSuceso] < 80, 8,
			    FactDiagnosticos[EdadSuceso] >= 80, 9,
			    10
			)
		formatString: 0
		lineageTag: 3b50cdac-0e36-4465-bf68-d8396f291783
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

