table FactMedicamentos
	lineageTag: 6dd1ecb1-94ed-4b55-9a9d-d33390b924f3

	measure 'Ördenes de Medicamentos' = COUNTROWS(FactMedicamentos)
		formatString: 0
		lineageTag: b17e1a26-2301-4c54-b735-c0f0b2d5091f

	measure 'Pacientes con órdenes' = DISTINCTCOUNT(FactMedicamentos[PacienteKey])
		formatString: 0
		lineageTag: 13f74d86-7b17-48a8-9a57-a85a414b2ad9

	measure 'Unidades indicadas' = SUM(FactMedicamentos[Cantidad])
		formatString: 0
		lineageTag: 2fa72fd2-48d4-48c3-ad6a-10bb8c00d081

	measure 'Resurtidos indicados' = SUM(FactMedicamentos[NumRefills])
		formatString: 0
		lineageTag: dfbe2ad5-7d17-4640-a4cb-f4fa44b55c4f

	measure 'Medicamentos distintos' = DISTINCTCOUNT(FactMedicamentos[MedicamentoKey])
		formatString: 0
		lineageTag: c5c49cf9-df29-41ae-9db3-d1f2c971b838

	measure 'Órdenes meses completos' = VAR UltimaFecha = MAXX(ALL(FactMedicamentos), RELATED(DimTiempo[Fecha])) VAR FinMesContexto = EOMONTH(MAX(DimTiempo[Fecha]), 0) RETURN IF(FinMesContexto = EOMONTH(UltimaFecha, 0) && UltimaFecha < EOMONTH(UltimaFecha, 0), BLANK(), [Ördenes de Medicamentos])
		formatString: 0
		lineageTag: 14345540-8fc3-478a-a5bf-c852766ebc71

