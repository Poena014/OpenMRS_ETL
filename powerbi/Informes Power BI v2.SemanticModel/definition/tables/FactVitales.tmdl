table FactVitales
	lineageTag: a1649d8d-1f71-4b4b-b6c1-f71a50380d4c

	measure 'Observaciones vitales' = COUNTROWS(FactVitales)
		formatString: 0
		lineageTag: 60939f59-3bd4-47ad-86b2-318cd71352dd

	measure 'Pacientes con signos vitales' = DISTINCTCOUNT(FactVitales[PacienteKey])
		formatString: 0
		lineageTag: 7488470d-a99f-4d11-9aa4-e94f5450eb3d

	measure 'Tipos de signos vitales' = DISTINCTCOUNT(FactVitales[SignoVitalKey])
		formatString: 0
		lineageTag: 21fc8f48-a244-498a-a126-c80d9f3ccf05

	measure 'Valor promedio' = AVERAGE(FactVitales[Valor])
		formatString: 0.00
		lineageTag: db3c2490-c100-40b1-a346-a7e63e826bc6

	measure 'Valor mínimo' = MIN(FactVitales[Valor])
		formatString: 0.00
		lineageTag: cff90cc6-c8c2-4cce-b16d-3cf67e3ae4f5

	measure 'Valor máximo' = MAX(FactVitales[Valor])
		formatString: 0.00
		lineageTag: d082cbb5-623b-4ef9-bb39-c78e65129853

	measure 'Observaciones meses completos' = VAR UltimaFecha = MAXX(ALL(FactVitales), RELATED(DimTiempo[Fecha])) VAR FinMesContexto = EOMONTH(MAX(DimTiempo[Fecha]), 0) RETURN IF(FinMesContexto = EOMONTH(UltimaFecha, 0) && UltimaFecha < EOMONTH(UltimaFecha, 0), BLANK(), [Observaciones vitales])
		formatString: 0
		lineageTag: f8602c98-1086-4f80-ad9f-1c64ccfa045f

	measure 'Observaciones promedio por paciente' = DIVIDE(COUNTROWS(FactVitales), DISTINCTCOUNT(FactVitales[PacienteKey]))
		lineageTag: 3976f018-832f-4aac-bc3b-b3822a43b438

		annotation PBI_FormatHint = {"isGeneralNumber":true}

